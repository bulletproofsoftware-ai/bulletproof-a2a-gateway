# ==== Agent-to-Agent Gateway ====
HOST=0.0.0.0
PORT=8100
# Comma-separated API keys that callers must present (Authorization). REQUIRED.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Per-key rate limit (requests/min)
RATE_LIMIT_RPM=60
# Audit log path
AUDIT_DB_PATH=./data/audit.db
