# ==== Agent-to-Agent Gateway ====

# --- Server ---
HOST=0.0.0.0
PORT=8100

# --- Authentication (REQUIRED) ---
# Comma-separated API keys callers must present in the X-API-Key header.
# Authenticated routes return 500 until this is set.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# --- Rate limiting ---
# Per-caller requests per minute. In-process, so it applies per worker.
RATE_LIMIT_RPM=60

# --- Agent registry ---
# Path to the capabilities YAML. Defaults to registry/capabilities.yaml
# alongside the source tree.
# A2A_REGISTRY_PATH=./registry/capabilities.yaml

# --- Invoker ---
# Which executor runs an agent: "subprocess" (default) or "echo".
# "echo" returns the prompt without executing anything — useful for smoke tests.
A2A_INVOKER_EXECUTOR=subprocess

# The command the subprocess executor runs. Placeholders {agent_id}, {prompt},
# and {context} are substituted after the line is split into arguments, so a
# value is always exactly one argument and is never passed through a shell.
# Omit {prompt} to have the prompt written to the command's stdin instead.
# REQUIRED when A2A_INVOKER_EXECUTOR=subprocess. See examples/README.md.
A2A_INVOKER_TEMPLATE=

# Seconds before an invocation is killed.
A2A_INVOKER_TIMEOUT_S=300

# --- Audit ---
# Every invocation POSTs a JSON event here. Best-effort: an unreachable sink
# logs a warning and never blocks the invocation. Any endpoint accepting a JSON
# body works; bulletproof-event-router is one such sink.
A2A_AUDIT_EVENT_ROUTER_URL=http://localhost:8085/events
# Seconds to wait for the audit sink before giving up.
A2A_AUDIT_TIMEOUT_S=1.5
